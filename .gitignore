# ==========================================
# SuperMart Enterprise Project - .gitignore
# ==========================================

# Dependencies
node_modules/
app/node_modules/
app/frontend/node_modules/

# Production Build Output
dist/
app/dist/
app/frontend/dist/

# Local Environment & Secrets
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor & OS Temporary Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# SQLite temporary/lock files (Preserves the main supermart.db seed)
*.db-journal
*.db-wal
*.db-shm

# Packet Tracer autosave / lock files
*.pka.tmp
*.pkt.bak
